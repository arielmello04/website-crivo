# ============ SERVIDOR ============
PORT=3000
NODE_ENV=production

# CORS — domínios permitidos, separados por vírgula
# Em dev: http://localhost:5500,http://127.0.0.1:5500
# Em prod: https://crivoco.com.br,https://www.crivoco.com.br
ALLOWED_ORIGINS=https://crivoco.com.br,https://www.crivoco.com.br

# ============ BANCO ============
# Caminho do arquivo SQLite (relativo à raiz do projeto)
DATABASE_PATH=./data/crivo.db

# ============ EMAIL (SMTP) ============
# Recomendação: usar Resend, Brevo (ex-Sendinblue), ou Gmail com App Password
# Exemplo Gmail: smtp.gmail.com / 587 / seu-email@gmail.com / app-password
# Exemplo Brevo: smtp-relay.brevo.com / 587 / seu-login / sua-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-aplicativo

# De quem o email é enviado
EMAIL_FROM="Crivo & Co. <contato@crivoco.com.br>"

# Para onde vão as notificações de novos briefings
EMAIL_NOTIFY=contato@crivoco.com.br

# Se quiser desabilitar o envio de email (modo dev/teste sem SMTP configurado)
EMAIL_ENABLED=true

# ============ ADMIN ============
# Token pra proteger GET /api/briefings — gere um valor forte (ex: openssl rand -hex 32)
ADMIN_TOKEN=
