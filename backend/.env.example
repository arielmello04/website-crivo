# ============ SERVIDOR ============
PORT=3000
NODE_ENV=production

# CORS — domínios permitidos, separados por vírgula
# Em dev: http://localhost:5500,http://127.0.0.1:5500
# Em prod: https://crivoco.com.br,https://www.crivoco.com.br
ALLOWED_ORIGINS=https://crivoco.com.br,https://www.crivoco.com.br

# ============ BANCO ============
# Caminho do arquivo SQLite (relativo à raiz do projeto)
DATABASE_PATH=./data/crivo.db

# ============ EMAIL (Brevo HTTP API) ============
# Cria em: brevo.com → API Keys → Generate a new API key
BREVO_API_KEY=xkeysib-...

# De quem o email é enviado — precisa estar verificado no Brevo (Senders & IP)
EMAIL_FROM="Crivo & Co. <crivoeco@gmail.com>"

# Para onde vão as notificações de novos briefings
EMAIL_NOTIFY=crivoeco@gmail.com

# Se quiser desabilitar o envio de email (modo dev/teste)
EMAIL_ENABLED=true

# ============ ADMIN ============
# Token pra proteger GET /api/briefings — gere um valor forte (ex: openssl rand -hex 32)
ADMIN_TOKEN=

# Senha que você usa na página /interno pra gerar links de questionário
ADMIN_SECRET=

# Segredo interno pra assinar os tokens (nunca exposto ao cliente)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=

# URL base do frontend (sem barra no final) — usada pra gerar os links de questionário
FRONTEND_URL=https://crivoco.com.br
